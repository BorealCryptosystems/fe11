    "oracle": {
      "kind": "IMPORT_CHARACTERIZATION_NOT_FIPS_VALIDATION_VERDICT",
      "codes": [
        "CKR_OK",
        "CKR_ATTRIBUTE_VALUE_INVALID",
        "CKR_TEMPLATE_INCONSISTENT",
        "CKR_FUNCTION_FAILED",
        "CKR_GENERAL_ERROR"
      ],
      "basis": "PKCS11 3.2 ML-KEM key object import representation and C_CreateObject, distinct from FIPS203 encapsulation/decapsulation input checking. No requirement that Create performs the ACVP key-check function is inferred.",
      "success": "Read class/key type/parameter set, retain provenance, explicitly destroy resulting session object; no encapsulation/decapsulation KAT credit",
      "refusal": "Retain exact producer/code; no successful object. FIPS expected false is not a mandated Create refusal; no normative conformance credit either way"
    },
    "expected_native_calls": [
      "C_Login",
      "C_CreateObject",
      "C_GetAttributeValue",
      "C_GetAttributeValue",
      "C_GetAttributeValue",
      "C_DestroyObject",
      "C_Logout",
      "C_CloseSession"
    ],
    "expected_refused_native_calls": [
      "C_Login",
      "C_CreateObject",
      "C_Logout",
      "C_CloseSession"
    ],
